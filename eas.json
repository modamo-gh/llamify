{
    "cli": {
        "version": ">= 16.19.3",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "env": { "RCT_NEW_ARCH_ENABLED": "0" }
        },
        "preview": {
            "distribution": "internal"
        },
        "production": {
            "autoIncrement": true,
            "env": { "RCT_NEW_ARCH_ENABLED": "0" }
        }
    },
    "submit": {
        "production": {}
    }
}
